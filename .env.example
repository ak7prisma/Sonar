# ==============================================================================
# SONAR — Environment Variable Template
# Copy this file to .env.local and fill in real values before deploying or testing
# cloud integrations. Never commit .env.local or real API secrets.
# ==============================================================================

# Application URL (used for auth callbacks and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase (PostgreSQL + pgvector + Auth + Storage + Realtime)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / Anon key (safe for browser SSR client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Optional legacy alias supported if publishable key is omitted
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key (SERVER ONLY — never expose to client bundles)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# AI Integration (Modular Server Provider — Default: Google Gemini Multimodal)
# ------------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
AI_PROVIDER=google
AI_CHAT_MODEL=gemini-2.5-flash
AI_VISION_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# Background Jobs (Inngest Durable Document Processing Workflows)
# ------------------------------------------------------------------------------
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ------------------------------------------------------------------------------
# Optional Production Rate Limiting (Upstash Redis — falls back to in-memory)
# ------------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
